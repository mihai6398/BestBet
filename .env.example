# Copy this file to .env and fill it in. .env is ignored by git and never goes into the image.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=bestbet
POSTGRES_USER=bestbet
# A long random string. It never has to be typed by hand.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Port on this machine for the server run from the IDE (localhost only).
POSTGRES_PORT=5432

# --- The first admin ---------------------------------------------------------
# Created on start if this account does not exist yet. At least 12 characters. Change it from the app
# after the first sign-in; once the account exists these two are not read again.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-at-least-12-characters

# Public sign-up. Leave it off: the admin creates everyone else's account.
AUTH_ALLOW_REGISTRATION=false

# --- The app -----------------------------------------------------------------
# 127.0.0.1 keeps the app on this machine. To let others in, put an HTTPS reverse proxy in front of it
# instead of changing this: the login cookie is only sent over HTTPS (or to localhost).
BESTBET_BIND=127.0.0.1
BESTBET_PORT=8080

# Optional: a free key from https://dashboard.api-football.com enables the pre-match model.
APIFOOTBALL_KEY=
